# Visma Net API credentials
# Get these from Visma Developer Portal: https://developer.visma.com
VISMA_CLIENT_ID=your_client_id_here
VISMA_CLIENT_SECRET=your_client_secret_here
VISMA_TENANT_ID=your_tenant_id_here

# Email sending via Resend (https://resend.com - free tier: 3000 emails/month)
RESEND_API_KEY=re_your_api_key_here

# Sender info shown in emails
EMAIL_FROM=Ditt Namn <ditt.namn@dindomän.se>
EMAIL_REPLY_TO=ditt.namn@dindomän.se
SENDER_NAME=Ditt Namn
SENDER_TITLE=B2B
COMPANY_NAME=Ditt Företag

# Optional: override order URL shown in the "Place order" button
ORDER_URL=https://dindomän.se/bestall

# Threshold: send reminder if customer is this many % past their avg interval
# Default 30 means: if avg interval is 30 days, remind after 39 days
OVERDUE_THRESHOLD_PCT=30

# How many months back to look when computing the average interval
LOOKBACK_MONTHS=6

# Set to "true" to do a dry run (log but don't send emails)
DRY_RUN=false
