# Obligatorisk – API-nyckel från https://platform.claude.com
ANTHROPIC_API_KEY=

# Er egen produktportfölj (styr hur ERP-fynd ramas in: kund / konkurrent / migreringsmöjlighet)
EGNA_PRODUKTER=Visma.net, Visma Business NXT, Visma Business, Visma Severa

# Omsättningsgräns i MSEK för snabbanalysens kvalificering
OMSATTNINGSGRANS_MSEK=25

# Modeller per analysläge (valfria – nedan är standardvärden)
# Snabbanalys: billigare/snabbare modell. Djupanalys: mest kapabla modellen.
MODEL_SNABB=claude-sonnet-4-6
MODEL_DJUP=claude-opus-4-8
