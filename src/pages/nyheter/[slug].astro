---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { useTranslations } from "@i18n/index";

export async function getStaticPaths() {
  const posts = await getCollection("news", (e) => !e.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const lang = "sv";
const t = useTranslations(lang);
const { Content } = await render(post);

const dateStr = post.data.pubDate.toLocaleDateString("sv-SE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={`${post.data.title} | Mikkeller Running Club Malmö`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  lang={lang}
>
  <article class="max-w-3xl mx-auto px-6 py-20">
    <div class="mb-8">
      <a href="/nyheter" class="text-sm text-[#5a5a70] hover:text-[#882c29] transition-colors flex items-center gap-1 mb-8">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        {t.news.title}
      </a>

      {post.data.image && (
        <img
          src={post.data.image}
          alt={post.data.imageAlt ?? post.data.title}
          class="w-full aspect-video object-cover rounded-xl mb-8"
        />
      )}

      <div class="flex items-center gap-2 text-xs text-[#8a8578] mb-4">
        <time datetime={post.data.pubDate.toISOString()}>{dateStr}</time>
        <span>&middot;</span>
        <span>{post.data.author}</span>
      </div>

      <h1 class="text-4xl md:text-5xl font-black leading-tight mb-4">
        {post.data.title}
      </h1>
      <p class="text-xl text-[#4a4a63] leading-relaxed">{post.data.description}</p>
    </div>

    <div class="prose prose-zinc max-w-none prose-headings:font-black prose-a:text-[#882c29] prose-a:no-underline hover:prose-a:underline">
      <Content />
    </div>
  </article>
</BaseLayout>
