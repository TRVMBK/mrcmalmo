---
import BaseLayout from "@layouts/BaseLayout.astro";
import EventCard from "@components/ui/EventCard.astro";
import { getAllEvents } from "@lib/events";
import { useTranslations } from "@i18n/index";

const lang = "en";
const t = useTranslations(lang);
const events = await getAllEvents();
---

<BaseLayout
  title={t.meta.eventsTitle}
  description={t.meta.eventsDescription}
  lang={lang}
>
  <div class="max-w-7xl mx-auto px-6 py-20">
    <div class="mb-12">
      <p class="text-orange-500 text-xs font-semibold uppercase tracking-widest mb-3">Join us</p>
      <h1 class="text-5xl md:text-6xl font-black text-white mb-4">{t.events.allEvents}</h1>
      <p class="text-zinc-400 max-w-xl">{t.events.subtitle}</p>
    </div>

    {events.length === 0 ? (
      <div class="text-center py-24 text-zinc-600">
        <p class="text-lg">{t.events.noEvents}</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {events.map((event) => (
          <EventCard event={event} lang={lang} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
