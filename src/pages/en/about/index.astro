---
import BaseLayout from "@layouts/BaseLayout.astro";
import { useTranslations } from "@i18n/index";

const lang = "en";
const t = useTranslations(lang);
---

<BaseLayout
  title={t.meta.aboutTitle}
  description={t.meta.aboutDescription}
  lang={lang}
>
  <div class="max-w-7xl mx-auto px-6 py-20">
    <div class="max-w-3xl mb-20">
      <p class="text-[#882c29] text-xs font-semibold uppercase tracking-widest mb-4">MRC Malmö</p>
      <h1 class="text-5xl md:text-7xl font-black leading-tight mb-6">
        {t.about.title}
      </h1>
      <p class="text-xl text-[#4a4a63] leading-relaxed">{t.about.body}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
      <div class="bg-[#faf6ec] border border-[#ddd0b6] rounded-xl p-8">
        <h2 class="text-2xl font-black mb-4">What is Mikkeller Running Club?</h2>
        <p class="text-[#4a4a63] leading-relaxed">
          Mikkeller Running Club was founded by the Danish brewery Mikkeller and now exists in over 100 cities worldwide. Each chapter runs on its own times and routes, but always with the same philosophy: run hard, drink good beer.
        </p>
      </div>
      <div class="bg-[#faf6ec] border border-[#ddd0b6] rounded-xl p-8">
        <h2 class="text-2xl font-black mb-4">MRC in Malmö</h2>
        <p class="text-[#4a4a63] leading-relaxed">
          The Malmö chapter has existed since 2017 and is one of the active MRC groups in Sweden. We run every week at various locations around Malmö – from Husie to Ribersborg, from Limhamn to Nyhamnen.
        </p>
      </div>
    </div>

    <div class="text-center bg-[#faf6ec] border border-[#ddd0b6] rounded-2xl p-12">
      <h2 class="text-3xl font-black mb-4">Ready to run with us?</h2>
      <p class="text-[#4a4a63] mb-8">Join our Facebook group and see when the next run is.</p>
      <a
        href="https://www.facebook.com/mrcmalmo"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-[#882c29] hover:bg-[#6f231f] text-white font-semibold px-8 py-4 rounded-xl transition-colors"
      >
        Join the group
      </a>
    </div>
  </div>
</BaseLayout>
