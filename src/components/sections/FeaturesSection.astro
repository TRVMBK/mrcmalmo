---
import type { Lang } from "@i18n/index";
import { features } from "@data/features";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";

const icons = {
  beer: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 11h1a3 3 0 010 6h-1"/><path d="M9 12v6"/><path d="M13 12v6"/><path d="M14 7.5c-1 0-1.44.5-3 .5s-2-.5-3-.5-1.44.5-3 .5"/><path d="M6 20v1a1 1 0 001 1h8a1 1 0 001-1v-1"/><path d="M7 7.5V5a1 1 0 011-1h6a1 1 0 011 1v2.5"/></svg>`,
  free: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 100 4h4a2 2 0 110 4H8"/><path d="M12 18V6"/></svg>`,
  groups: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`,
  globe: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>`,
  pin: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  team: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
};
---

<section class="py-24 bg-[#161616] border-t border-[#1e1e1e]">
  <div class="max-w-7xl mx-auto px-6">

    <div class="mb-14">
      <span class="skane-bar mb-5"></span>
      <h2 class="text-4xl md:text-5xl font-black text-white">
        {sv ? "Varför springa med MRC?" : "Why run with MRC?"}
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/8">
      {features.map((f) => (
        <div class="bg-[#161616] p-8 group hover:bg-[#1c1c1c] transition-colors">
          <div class="mb-5 text-[#E23A23] group-hover:text-[#F7DE10] transition-colors">
            <Fragment set:html={icons[f.icon]} />
          </div>
          <h3 class="text-white font-bold text-base mb-2.5">
            {sv ? f.titleSv : f.titleEn}
          </h3>
          <p class="text-white/60 text-sm leading-relaxed">
            {sv ? f.bodySv : f.bodyEn}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
