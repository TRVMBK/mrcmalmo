---
import type { Lang } from "@i18n/index";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";
---

<section class="py-24 bg-[#0c0c0c] border-t border-[#1e1e1e]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <div>
        <span class="skane-bar mb-5"></span>
        <h2 class="text-4xl md:text-5xl font-black text-white mb-6">
          {sv ? "Om MRC Malmö" : "About MRC Malmö"}
        </h2>
        <p class="text-white/75 text-lg leading-relaxed mb-5">
          {sv
            ? "Mikkeller Running Club Malmø är en av hundratals MRC-kapitel runt om i världen. Vi samlas varje vecka för en gemensam löptur – och sedan dryck och gemenskap."
            : "Mikkeller Running Club Malmø is one of hundreds of MRC chapters around the world. We gather every week for a group run – and then drinks and community."}
        </p>
        <p class="text-white/55 leading-relaxed mb-8">
          {sv
            ? "Det spelar ingen roll om du springer 5 km eller 20 km, om du är nybörjare eller veteran. Det enda kravet är att du vill ha kul. Vårt motto: \"No one is left behind\". Här hittar du vänner för livet."
            : "It doesn't matter if you run 5 km or 20 km, whether you're a beginner or a veteran. The only requirement is that you want to have fun. Our motto: \"No one is left behind\". Here you'll find friends for life."}
        </p>
        <p class="text-white/50 text-xs">
          {sv
            ? "Denna sida är skapad av och för MRC Malmø-medlemmar, inte en officiell Mikkeller Running Club-sida."
            : "This site is created by and for MRC Malmø members, not an official Mikkeller Running Club site."}
        </p>
      </div>

      <!-- Skyline logo showcase -->
      <div class="relative">
        <div class="rounded-2xl border border-[#E23A23]/20 bg-[#161616] p-12 flex items-center justify-center aspect-square max-w-sm mx-auto">
          <!-- Yellow cross — subtle Skåne nod -->
          <div class="absolute inset-0 opacity-5 pointer-events-none" aria-hidden="true">
            <div class="absolute top-1/2 left-0 right-0 h-px bg-[#F7DE10] -translate-y-1/2"></div>
            <div class="absolute left-1/2 top-0 bottom-0 w-px bg-[#F7DE10] -translate-x-1/2"></div>
          </div>
          <img
            src="/logos/MRC - Skyline - white.svg"
            alt="MRC Malmö Skyline"
            class="w-full max-w-xs drop-shadow-[0_0_40px_rgba(226,58,35,0.15)]"
          />
        </div>
        <!-- Red glow behind card -->
        <div class="absolute inset-0 -z-10 blur-3xl opacity-10 bg-[#E23A23] rounded-full"></div>
      </div>

    </div>
  </div>
</section>
