---
import type { Lang } from "@i18n/index";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";
---

<section class="py-24 bg-[#eee5d2] border-t border-[#ddd0b6]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <div>
        <span class="skane-bar mb-5"></span>
        <h2 class="text-4xl md:text-5xl font-black mb-6">
          {sv ? "Om MRC Malmö" : "About MRC Malmö"}
        </h2>
        <p class="text-[#4a4a63] text-lg leading-relaxed mb-5">
          {sv
            ? "Mikkeller Running Club Malmø är en av hundratals MRC-kapitel runt om i världen. Vi samlas varje vecka för en gemensam löptur – och sedan dryck och gemenskap."
            : "Mikkeller Running Club Malmø is one of hundreds of MRC chapters around the world. We gather every week for a group run – and then drinks and community."}
        </p>
        <p class="text-[#5a5a70] leading-relaxed mb-8">
          {sv
            ? "Det spelar ingen roll om du springer 5 km eller 20 km, om du är nybörjare eller veteran. Det enda kravet är att du vill ha kul. Vårt motto: \"No one is left behind\". Här hittar du vänner för livet."
            : "It doesn't matter if you run 5 km or 20 km, whether you're a beginner or a veteran. The only requirement is that you want to have fun. Our motto: \"No one is left behind\". Here you'll find friends for life."}
        </p>
        <p class="text-[#8a8578] text-xs">
          {sv
            ? "Denna sida är skapad av och för MRC Malmø-medlemmar, inte en officiell Mikkeller Running Club-sida."
            : "This site is created by and for MRC Malmø members, not an official Mikkeller Running Club site."}
        </p>
      </div>

      <!-- Skyline logo showcase -->
      <div class="relative">
        <div class="rounded-2xl border border-[#357c4f]/25 bg-[#faf6ec] p-12 flex items-center justify-center aspect-square max-w-sm mx-auto">
          <!-- Moss cross — subtle nod -->
          <div class="absolute inset-0 opacity-10 pointer-events-none" aria-hidden="true">
            <div class="absolute top-1/2 left-0 right-0 h-px bg-[#357c4f] -translate-y-1/2"></div>
            <div class="absolute left-1/2 top-0 bottom-0 w-px bg-[#357c4f] -translate-x-1/2"></div>
          </div>
          <img
            src="/logos/MRC - Skyline - green.svg"
            alt="MRC Malmö Skyline"
            class="w-full max-w-xs drop-shadow-[0_0_40px_rgba(53,124,79,0.2)]"
          />
        </div>
        <!-- Moss glow behind card -->
        <div class="absolute inset-0 -z-10 blur-3xl opacity-[0.08] bg-[#357c4f] rounded-full"></div>
      </div>

    </div>
  </div>
</section>
