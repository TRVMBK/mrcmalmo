---
import { useTranslations } from "@i18n/index";
import type { Lang } from "@i18n/index";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Official Facebook Page (Page Plugin works here)
const officialPageUrl = "https://www.facebook.com/mrcmalmo";
// Members group (private – shown as link only)
const membersGroupUrl = "https://www.facebook.com/groups/973407251210619/";
const sdkLocale = lang === "en" ? "en_US" : "sv_SE";
---

<section class="py-24 bg-[#faf6ec]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-12">
      <p class="text-[#882c29] text-xs font-semibold uppercase tracking-widest mb-2">Facebook</p>
      <h2 class="text-4xl md:text-5xl font-black mb-4">{t.feed.title}</h2>
      <p class="text-[#4a4a63] max-w-lg mx-auto">{t.feed.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      <!-- Official Facebook Page embed (Page Plugin) -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 rounded-full bg-[#882c29]"></span>
          <h3 class="text-sm font-semibold text-[#4a4a63] uppercase tracking-wider">{t.feed.officialGroup}</h3>
        </div>
        <div class="rounded-xl overflow-hidden border border-[#ddd0b6] bg-[#eee5d2] flex justify-center">
          <div
            class="fb-page"
            data-href={officialPageUrl}
            data-tabs="timeline"
            data-width="500"
            data-height="500"
            data-small-header="true"
            data-adapt-container-width="true"
            data-hide-cover="false"
            data-show-facepile="false"
          ></div>
        </div>
        <p class="mt-3 text-center">
          <a
            href={officialPageUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-[#5a5a70] hover:text-[#882c29] transition-colors"
          >
            {t.feed.openGroup} →
          </a>
        </p>
      </div>

      <!-- Members group link + info -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 rounded-full bg-zinc-600"></span>
          <h3 class="text-sm font-semibold text-[#4a4a63] uppercase tracking-wider">{t.feed.membersGroup}</h3>
        </div>
        <div class="rounded-xl border border-[#ddd0b6] bg-[#eee5d2] p-8 flex flex-col items-center justify-center text-center min-h-[300px]">
          <svg
            width="48"
            height="48"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="text-[#8a8578] mb-6"
          >
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <p class="text-[#4a4a63] text-sm leading-relaxed mb-6 max-w-xs">
            {lang === "sv"
              ? "Medlemsgruppen är privat. Gå med i den officiella gruppen för att ansöka om tillgång."
              : "The members group is private. Join the official group to request access."}
          </p>
          <a
            href={membersGroupUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border border-[#ddd0b6] hover:border-[#882c29] text-[#3a3a52] hover:text-[#6f231f] text-sm font-semibold px-5 py-2.5 rounded-lg transition-all duration-200"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            {lang === "sv" ? "Öppna medlemsgruppen" : "Open members group"}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Facebook SDK – async, non-blocking -->
<div id="fb-root"></div>
<script define:vars={{ sdkLocale }}>
  window.fbAsyncInit = function () {
    FB.init({ xfbml: true, version: "v22.0" });
  };
  (function (d, s, id) {
    if (d.getElementById(id)) return;
    const js = d.createElement(s);
    js.id = id;
    js.src = `https://connect.facebook.net/${sdkLocale}/sdk.js`;
    const fjs = d.getElementsByTagName(s)[0];
    fjs.parentNode.insertBefore(js, fjs);
  })(document, "script", "facebook-jssdk");
</script>
