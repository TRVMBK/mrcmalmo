---
import type { Lang } from "@i18n/index";
import { FLYER_URL, SHOP_URL } from "../../data/shop";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";

const logoTypes = [
  {
    id: "skyline",
    nameSv: "Skyline",
    nameEn: "Skyline",
    descSv: "Malmös siluett med löpande figurer",
    descEn: "Malmö skyline with running figures",
  },
  {
    id: "henry-sally",
    nameSv: "Henry & Sally",
    nameEn: "Henry & Sally",
    descSv: "De klassiska MRC-löparfigurerna",
    descEn: "The classic MRC running figures",
  },
  {
    id: "yin-yang",
    nameSv: "Yin Yang",
    nameEn: "Yin Yang",
    descSv: "Balans mellan löpning och öl",
    descEn: "Balance between running and beer",
  },
];

const colors = [
  { id: "white",  labelSv: "Vit",    labelEn: "White",  bg: "bg-[#0f0f54]",  border: "border-[#0f0f54]" },
  { id: "black",  labelSv: "Svart",  labelEn: "Black",  bg: "bg-white",   border: "border-black/10" },
  { id: "red",    labelSv: "Röd",    labelEn: "Red",    bg: "bg-[#eee5d2]",  border: "border-[#ddd0b6]" },
  { id: "yellow", labelSv: "Gul",    labelEn: "Yellow", bg: "bg-[#eee5d2]",  border: "border-[#ddd0b6]" },
  { id: "purple", labelSv: "Lila",   labelEn: "Purple", bg: "bg-[#eee5d2]",  border: "border-[#ddd0b6]" },
];

const formats = ["svg", "eps", "png", "webp"];

function fileName(type: string, color: string) {
  const map: Record<string, string> = {
    "skyline": "Skyline",
    "henry-sally": "Henry & Sally",
    "yin-yang": "Yin Yang",
  };
  return `MRC - ${map[type]} - ${color}`;
}
---

<div class="min-h-screen bg-[#eee5d2] pt-24 pb-24">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Header -->
    <div class="mb-16 text-center">
      <span class="inline-block w-10 h-0.5 bg-[#357c4f] mb-6"></span>
      <h1 class="text-5xl md:text-6xl font-black mb-4">
        {sv ? "Logotyper" : "Logos"}
      </h1>
      <p class="text-[#5a5a70] max-w-lg mx-auto text-base leading-relaxed">
        {sv
          ? "Tre varianter i fyra färger. Välj den version som passar ditt sammanhang och ladda ner i önskat format."
          : "Three variants in four colours. Choose the version that fits your context and download in your preferred format."}
      </p>
    </div>

    <!-- One section per logo type -->
    {logoTypes.map((type) => (
      <div class="mb-20">
        <!-- Section heading -->
        <div class="flex items-baseline gap-4 mb-6 border-b border-[#ddd0b6] pb-4">
          <h2 class="text-2xl font-black">{sv ? type.nameSv : type.nameEn}</h2>
          <span class="text-[#5a5a70] text-sm">{sv ? type.descSv : type.descEn}</span>
        </div>

        <!-- 4 color cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {colors.map((color) => {
            const base = fileName(type.id, color.id);
            return (
              <div class={`rounded-xl border ${color.border} overflow-hidden flex flex-col`}>

                <!-- Preview area -->
                <div class={`${color.bg} aspect-square flex items-center justify-center p-3`}>
                  <img
                    src={`/logos/${base}.svg`}
                    alt={`MRC ${sv ? type.nameSv : type.nameEn} – ${sv ? color.labelSv : color.labelEn}`}
                    class="w-full h-auto object-contain"
                    loading="lazy"
                  />
                </div>

                <!-- Color label + formats -->
                <div class="bg-[#faf6ec] p-4 flex flex-col gap-3 flex-1">
                  <div class="flex items-center gap-2">
                    <span class={`w-3 h-3 rounded-full border border-[#ddd0b6] ${
                      color.id === "white"  ? "bg-white" :
                      color.id === "black"  ? "bg-black" :
                      color.id === "red"    ? "bg-[#882c29]" :
                      color.id === "purple" ? "bg-[#7B2FBE]" :
                                             "bg-[#357c4f]"
                    }`}></span>
                    <span class=" font-semibold text-sm">{sv ? color.labelSv : color.labelEn}</span>
                  </div>

                  <!-- Format buttons -->
                  <div class="flex gap-1 flex-nowrap">
                    {formats.map((fmt) => (
                      <a
                        href={`/logos/${base}.${fmt}`}
                        download={`MRC-${type.id}-${color.id}.${fmt}`}
                        class="flex items-center gap-0.5 text-[10px] font-bold uppercase tracking-wide px-2 py-1 rounded border border-[#ddd0b6] text-[#5a5a70] hover:text-[#882c29] hover:border-[#882c29]/60 hover:bg-[#882c29]/8 transition-all"
                      >
                        <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        {fmt}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))}

    <!-- Font download -->
    <div class="mb-20">
      <div class="flex items-baseline gap-4 mb-6 border-b border-[#ddd0b6] pb-4">
        <h2 class="text-2xl font-black">{sv ? "Typsnitt" : "Typeface"}</h2>
        <span class="text-[#5a5a70] text-sm">Mikkeller Special Brew</span>
      </div>
      <div class="rounded-xl border border-[#ddd0b6] bg-[#faf6ec] p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="min-w-0">
          <p class="mikkel-font text-4xl md:text-5xl leading-tight break-words">Mikkeller Running Club Malmö</p>
          <p class="mikkel-font text-xl text-[#5a5a70] mt-3 break-words">ABCDEFGHIJKLM NOPQRSTUVWXYZ 0123456789</p>
          <p class="text-[#5a5a70] text-sm mt-4">
            {sv
              ? "Typsnittet som används i Mikkellers profil. Perfekt till egna tröjor och tryck."
              : "The typeface used in the Mikkeller identity. Great for custom shirts and prints."}
          </p>
        </div>
        <a
          href="/fonts/MikkelWind.ttf"
          download="MikkelWind.ttf"
          class="inline-flex items-center gap-3 bg-[#882c29] hover:bg-[#6f231f] text-white font-bold px-6 py-3.5 rounded-lg transition-colors text-sm whitespace-nowrap"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          {sv ? "Ladda ner TTF" : "Download TTF"}
        </a>
      </div>
    </div>

    <!-- Flyer download -->
    <div class="mb-20">
      <div class="flex items-baseline gap-4 mb-6 border-b border-[#ddd0b6] pb-4">
        <h2 class="text-2xl font-black">{sv ? "Reklamblad" : "Flyer"}</h2>
        <span class="text-[#5a5a70] text-sm">{sv ? "A4 · PDF · med QR-kod till klubbshopen" : "A4 · PDF · with QR code to the club shop"}</span>
      </div>
      <div class="rounded-xl border border-[#ddd0b6] bg-[#faf6ec] p-8 flex flex-col sm:flex-row items-center gap-8">
        <img
          src="/images/reklamblad-preview.jpg"
          alt={sv ? "Reklamblad för Mikkeller Running Club Malmös klubbshop" : "Flyer for the Mikkeller Running Club Malmö club shop"}
          width="600"
          height="849"
          class="w-40 h-auto rounded-lg border border-[#ddd0b6] shadow-sm shrink-0"
          loading="lazy"
        />
        <div class="flex-1 min-w-0 text-center sm:text-left">
          <p class="text-[#5a5a70] text-sm leading-relaxed mb-5 max-w-xl">
            {sv
              ? "Skriv ut och sätt upp i lokaler, på krogen eller dela digitalt. QR-koden leder till vår klubbshop hos Netshirt, där du kan handla officiella MRC-kläder."
              : "Print it and put it up at venues and pubs, or share it digitally. The QR code leads to our club shop at Netshirt, where you can buy official MRC apparel."}
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center sm:justify-start">
            <a
              href={FLYER_URL}
              download="Reklamblad-Mikkeller-Running-Club-2026.pdf"
              class="inline-flex items-center justify-center gap-3 bg-[#882c29] hover:bg-[#6f231f] text-white font-bold px-6 py-3.5 rounded-lg transition-colors text-sm whitespace-nowrap"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              {sv ? "Ladda ner PDF" : "Download PDF"}
            </a>
            <a
              href={SHOP_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 border border-[#ddd0b6] hover:border-[#357c4f]/60 font-bold px-6 py-3.5 rounded-lg transition-all text-sm whitespace-nowrap"
            >
              {sv ? "Till klubbshopen" : "Go to the club shop"}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Download all -->
    <div class="mt-8 pt-12 border-t border-[#ddd0b6] flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <p class=" font-semibold">{sv ? "Ladda ner allt" : "Download everything"}</p>
        <p class="text-[#5a5a70] text-sm mt-0.5">{sv ? "Alla logotyper, alla färger, alla format" : "All logos, all colours, all formats"}</p>
      </div>
      <a
        href="/logos/mrc-malmo-logo-pack.zip"
        download="mrc-malmo-logo-pack.zip"
        class="inline-flex items-center gap-3 bg-[#882c29] hover:bg-[#6f231f] text-white font-bold px-6 py-3.5 rounded-lg transition-colors text-sm whitespace-nowrap"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        {sv ? "Ladda ner ZIP" : "Download ZIP"}
      </a>
    </div>

    <!-- Usage note -->
    <div class="mt-10 bg-[#faf6ec] border border-[#ddd0b6] rounded-xl p-6 flex gap-4">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[#357c4f] shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
      <div>
        <p class=" font-semibold text-sm mb-1">{sv ? "Användningsriktlinjer" : "Usage guidelines"}</p>
        <p class="text-[#5a5a70] text-sm leading-relaxed">
          {sv
            ? "Logotyperna får användas i sammanhang relaterade till Mikkeller Running Club Malmö. Ändra inte färger eller proportioner. Denna sida är skapad av MRC Malmö-medlemmar och är inte en officiell Mikkeller-sida."
            : "The logos may be used in contexts related to Mikkeller Running Club Malmö. Do not alter colours or proportions. This page is created by MRC Malmö members and is not an official Mikkeller page."}
        </p>
        <p class="text-[#5a5a70] text-sm leading-relaxed mt-3">
          {sv
            ? "Är du osäker på vad som gäller när du gör egna tröjor eller prylar? Hör av dig till oss. Det finns inga strikta regler som måste följas till punkt och pricka — vi hjälper gärna till och fungerar som bollplank."
            : "If anyone is unsure about what can or cannot be done when creating their own shirts or gear, feel free to reach out to us. There are no strict rules that need to be blindly followed, but we're happy to help and act as a sounding board if needed."}
        </p>
      </div>
    </div>

  </div>
</div>

<style is:global>
  @font-face {
    font-family: "Mikkeller Special Brew";
    src: url("/fonts/MikkelWind.ttf") format("truetype");
    font-display: swap;
  }
  .mikkel-font {
    font-family: "Mikkeller Special Brew", system-ui, sans-serif;
  }
</style>
