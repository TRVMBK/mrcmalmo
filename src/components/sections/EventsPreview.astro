---
import { useTranslations, getLocalizedPath } from "@i18n/index";
import type { Lang } from "@i18n/index";
import EventCard from "@components/ui/EventCard.astro";
import type { MergedEvent } from "@lib/facebook";

interface Props {
  lang: Lang;
  events: MergedEvent[];
}
const { lang, events } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-24 bg-[#eee5d2]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-end justify-between mb-12">
      <div>
        <p class="text-[#882c29] text-xs font-semibold uppercase tracking-widest mb-2">
          {lang === "sv" ? "Häng med" : "Join us"}
        </p>
        <h2 class="text-4xl md:text-5xl font-black">{t.events.title}</h2>
      </div>
      <a
        href={getLocalizedPath(lang, "/events")}
        class="hidden sm:flex items-center gap-2 text-sm font-semibold text-[#4a4a63] hover:text-[#882c29] transition-colors"
      >
        {t.events.seeAll}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    {events.length === 0 ? (
      <div class="text-center py-20 text-[#8a8578]">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4 opacity-40">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <p>{t.events.noEvents}</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {events.slice(0, 3).map((event) => (
          <EventCard event={event} lang={lang} />
        ))}
      </div>
    )}

    {events.length > 0 && (
      <div class="mt-8 text-center sm:hidden">
        <a
          href={getLocalizedPath(lang, "/events")}
          class="text-sm font-semibold text-[#882c29] hover:text-[#6f231f] transition-colors"
        >
          {t.events.seeAll} →
        </a>
      </div>
    )}
  </div>
</section>
