---
import { getLocalizedPath } from "@i18n/index";
import type { Lang } from "@i18n/index";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";
const year = new Date().getFullYear();
---

<footer class="border-t border-[#1e1e1e] bg-[#0c0c0c]">
  <div class="max-w-7xl mx-auto px-6 py-16">

    <div class="flex flex-col md:flex-row justify-between gap-12 mb-12">

      <!-- Brand -->
      <div class="max-w-xs">
        <img
          src="/logos/MRC - Skyline - white.svg"
          alt="MRC Malmö"
          class="h-10 w-auto mb-4 opacity-80"
        />
        <p class="text-neutral-600 text-sm leading-relaxed">
          {sv ? "Spring med oss. Drick med oss." : "Run with us. Drink with us."}
        </p>
        <!-- Skåne flag colors bar -->
        <div class="mt-4 flex gap-1">
          <div class="h-1 w-8 rounded bg-[#E23A23]"></div>
          <div class="h-1 w-4 rounded bg-[#F7DE10]"></div>
          <div class="h-1 flex-1 rounded bg-[#E23A23]"></div>
        </div>
      </div>

      <!-- Social links -->
      <div>
        <h3 class="text-xs font-semibold text-neutral-600 uppercase tracking-widest mb-4">
          {sv ? "Följ oss" : "Follow us"}
        </h3>
        <ul class="space-y-2.5">
          <li>
            <a href="https://www.facebook.com/mrcmalmo" target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 text-sm text-neutral-500 hover:text-white transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              Facebook
            </a>
          </li>
          <li>
            <a href="https://www.facebook.com/groups/973407251210619" target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 text-sm text-neutral-500 hover:text-white transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              {sv ? "Facebook-grupp" : "Facebook group"}
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/mrc_malmo" target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 text-sm text-neutral-500 hover:text-white transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              Instagram
            </a>
          </li>
          <li>
            <a href="https://www.strava.com/clubs/mrcmalmo" target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 text-sm text-neutral-500 hover:text-white transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg>
              Strava
            </a>
          </li>
        </ul>
      </div>

      <!-- Pages -->
      <div>
        <h3 class="text-xs font-semibold text-neutral-600 uppercase tracking-widest mb-4">
          {sv ? "Sidor" : "Pages"}
        </h3>
        <ul class="space-y-2.5">
          <li><a href={getLocalizedPath(lang, "/")} class="text-sm text-neutral-500 hover:text-white transition-colors">{sv ? "Hem" : "Home"}</a></li>
          <li><a href={getLocalizedPath(lang, "/logotyp")} class="text-sm text-neutral-500 hover:text-white transition-colors">{sv ? "Logotyp" : "Logo"}</a></li>
          <li><a href="https://mikkeller.com/mrc" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-500 hover:text-white transition-colors">MRC Global</a></li>
        </ul>
      </div>

    </div>

    <div class="border-t border-[#1e1e1e] pt-8 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-xs text-neutral-700">
        &copy; {year} Mikkeller Running Club Malmö
      </p>
      <p class="text-xs text-neutral-800">Malmö, Sverige</p>
    </div>
  </div>
</footer>
