---
import type { Lang } from "@i18n/index";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  slug: string;
  image?: string;
  lang: Lang;
}
const { title, description, pubDate, author, slug, image, lang } = Astro.props;
const dateStr = pubDate.toLocaleDateString(lang === "sv" ? "sv-SE" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const href = lang === "en" ? `/en/news/${slug}` : `/nyheter/${slug}`;
---

<article class="group bg-[#faf6ec] border border-[#ddd0b6] rounded-xl overflow-hidden hover:border-[#882c29]/40 transition-all duration-300">
  {image && (
    <a href={href} class="block aspect-video overflow-hidden">
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    </a>
  )}
  <div class="p-6">
    <div class="flex items-center gap-2 text-xs text-[#8a8578] mb-3">
      <time datetime={pubDate.toISOString()}>{dateStr}</time>
      <span>&middot;</span>
      <span>{author}</span>
    </div>
    <h3 class="font-bold text-lg leading-snug mb-2 group-hover:text-[#6f231f] transition-colors">
      <a href={href}>{title}</a>
    </h3>
    <p class="text-[#4a4a63] text-sm leading-relaxed line-clamp-3 mb-4">
      {description}
    </p>
    <a
      href={href}
      class="text-xs font-semibold text-[#882c29] hover:text-[#6f231f] transition-colors flex items-center gap-1"
    >
      {lang === "sv" ? "Läs mer" : "Read more"}
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>
