---
interface Props {
  href: string;
  variant?: "primary" | "ghost" | "outline";
  target?: string;
  rel?: string;
  class?: string;
}
const { href, variant = "primary", target, rel, class: className } = Astro.props;

const base = "inline-flex items-center gap-2 font-semibold text-sm px-6 py-3 rounded transition-all duration-200";
const variants = {
  primary: "bg-orange-500 hover:bg-orange-400 text-white shadow-lg shadow-orange-500/20",
  ghost: "text-zinc-300 hover:text-white border border-zinc-700 hover:border-zinc-500",
  outline: "border border-orange-500 text-orange-500 hover:bg-orange-500 hover:text-white",
};
---

<a
  href={href}
  target={target}
  rel={rel}
  class={`${base} ${variants[variant]} ${className ?? ""}`}
>
  <slot />
</a>
