---
interface Props {
  href: string;
  variant?: "primary" | "ghost" | "outline";
  target?: string;
  rel?: string;
  class?: string;
}
const { href, variant = "primary", target, rel, class: className } = Astro.props;

const base = "inline-flex items-center gap-2 font-semibold text-sm px-6 py-3 rounded transition-all duration-200";
const variants = {
  primary: "bg-[#882c29] hover:bg-[#6f231f] text-white shadow-lg shadow-[#882c29]/20",
  ghost: "text-[#3a3a52] hover:text-[#882c29] border border-[#ddd0b6] hover:border-[#882c29]/50",
  outline: "border border-[#882c29] text-[#882c29] hover:bg-[#882c29] hover:text-white",
};
---

<a
  href={href}
  target={target}
  rel={rel}
  class={`${base} ${variants[variant]} ${className ?? ""}`}
>
  <slot />
</a>
