---
import type { Lang } from "@i18n/index";
import type { MergedEvent } from "@lib/facebook";
import { getEventDate, getEventTitle, getEventDescription, getEventLocation } from "@lib/events";

interface Props {
  event: MergedEvent;
  lang: Lang;
}
const { event, lang } = Astro.props;

const date = getEventDate(event);
const title = getEventTitle(event, lang);
const description = getEventDescription(event, lang);
const location = getEventLocation(event);

const facebookUrl = event.source === "facebook"
  ? `https://www.facebook.com/events/${(event as any).id}`
  : (event as any).facebookEventUrl;

const cover = event.source === "facebook" ? (event as any).cover?.source : (event as any).image;

const dayNum = date.toLocaleDateString(lang === "sv" ? "sv-SE" : "en-US", { day: "numeric" });
const monthShort = date.toLocaleDateString(lang === "sv" ? "sv-SE" : "en-US", { month: "short" });
const timeStr = date.toLocaleTimeString(lang === "sv" ? "sv-SE" : "en-US", { hour: "2-digit", minute: "2-digit" });
---

<article class="group bg-[#faf6ec] border border-[#ddd0b6] rounded-xl overflow-hidden hover:border-[#882c29]/40 transition-all duration-300 hover:shadow-xl hover:shadow-[#882c29]/5">
  {cover && (
    <div class="aspect-video overflow-hidden">
      <img
        src={cover}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    </div>
  )}
  {!cover && (
    <div class="aspect-video bg-[#ddd0b6] flex items-center justify-center">
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" class="text-[#8a8578]">
        <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="2"/>
        <path d="M16 28 C16 28 18 22 24 22 C30 22 32 28 32 28" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <circle cx="24" cy="18" r="3" fill="currentColor" opacity="0.4"/>
      </svg>
    </div>
  )}

  <div class="p-6">
    <div class="flex items-start gap-4 mb-4">
      <div class="flex-shrink-0 text-center bg-[#eee5d2] border border-[#ddd0b6] rounded-lg px-3 py-2 min-w-[56px]">
        <div class="text-2xl font-black leading-none">{dayNum}</div>
        <div class="text-xs font-semibold text-[#882c29] uppercase tracking-wide mt-1">{monthShort}</div>
      </div>
      <div class="flex-1 min-w-0">
        <h3 class="font-bold text-lg leading-snug group-hover:text-[#6f231f] transition-colors line-clamp-2">
          {title}
        </h3>
        <div class="flex items-center gap-1 mt-1 text-[#5a5a70] text-sm">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span class="truncate">{location}</span>
        </div>
      </div>
    </div>

    <p class="text-[#4a4a63] text-sm leading-relaxed line-clamp-3 mb-4">
      {description}
    </p>

    <div class="flex items-center justify-between">
      <span class="text-xs text-[#8a8578]">{timeStr}</span>
      {facebookUrl && (
        <a
          href={facebookUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold text-[#882c29] hover:text-[#6f231f] transition-colors flex items-center gap-1"
        >
          {lang === "sv" ? "Anmäl på Facebook" : "RSVP on Facebook"}
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M7 17L17 7M17 7H7M17 7v10"/>
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
